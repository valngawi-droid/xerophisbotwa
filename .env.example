# ============================================================
# XEROPHIS BOT — contoh konfigurasi environment
# Copy file ini menjadi `.env` lalu isi sesuai kebutuhan.
# Semua variabel OPSIONAL — bot tetap jalan dengan nilai bawaan.
# ============================================================

# --- KONEKSI (nomor WA yang dipakai bot, format internasional TANPA +) ---
# Contoh Mali   : PAIRING_NUMBER=22370123456
# Contoh Rusia  : PAIRING_NUMBER=79225440657
# Contoh Indonesia: PAIRING_NUMBER=6281234567890
# Kosongkan untuk ditanya interaktif saat start.
PAIRING_NUMBER=

# --- OWNER (bisa banyak, pisahkan koma) ---
# Contoh: OWNER_NUMBER=22370123456,79225440657
OWNER_NUMBER=

# --- REGION / ZONA WAKTU ---
# Mali: Africa/Bamako | Rusia: Europe/Moscow | Indonesia: Asia/Jakarta
BOT_TZ=Africa/Bamako
BOT_LOCALE=id
# Kode negara default untuk nomor lokal "08xx..." (Mali=223, Rusia=7, Indonesia=62)
DEFAULT_COUNTRY=223

# --- API KEYS (opsional, menimpa bawaan config.js) ---
GEMINI_API_KEY=
LOLHUMAN_KEY=
NEOXR_KEY=
GROQ_KEY=
BETABOTZ_KEY=

# --- LAINNYA ---
# NODE_ENV=production untuk mematikan hot-reload dev
NODE_ENV=production
